arrange(pct_change) %>%
rename(
Term        = term,
`Exp(Coef)` = estimate,
`Std.Error` = std.error,
`Z-value`   = statistic,
`P-value`   = p.value
) %>%
mutate(`P-value` = round(`P-value`, 3)) %>%
select(Term, `Exp(Coef)`, Effect, `P-value`) %>%
kable()
